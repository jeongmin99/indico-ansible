[Unit]
Description=Indico Celery
After=network.target

[Service]
ExecStart={{ indico_venv }}/bin/indico celery worker -B
Restart=always
SyslogIdentifier=indico-celery
User={{ indico_user }}
Group={{ indico_group }}
UMask=0027
Type=simple
KillMode=mixed
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
